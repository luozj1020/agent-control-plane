{
  "name": "agent-control-plane",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first workflow Skill manager for coding-agent collaboration.",
  "bin": {
    "agent-control-plane": "apps/web/balanced-cli.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm --workspace @agent-control-plane/web run dev",
    "balanced": "node apps/web/balanced-cli.mjs balanced",
    "start": "npm --workspace @agent-control-plane/web run start",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24"
  }
}
