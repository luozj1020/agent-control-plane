{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-workflow.local/schemas/harness-manifest-v1.schema.json",
  "title": "Harness Manifest v1",
  "description": "Language-neutral discovery metadata for one pluggable Agent Harness adapter.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "displayName",
    "adapterVersion",
    "lifecycle",
    "roles",
    "providerPolicy",
    "capabilities"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "displayName": {"$ref": "#/$defs/nonempty"},
    "adapterVersion": {"$ref": "#/$defs/nonempty"},
    "configSchemaVersion": {"$ref": "#/$defs/nonempty"},
    "lifecycle": {
      "enum": ["experimental", "preview", "stable", "deprecated", "removed"]
    },
    "trustLevel": {
      "enum": ["built-in", "verified", "community", "local"],
      "default": "local"
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream", "downstream"],
      "properties": {
        "upstream": {"type": "boolean"},
        "downstream": {"type": "boolean"}
      }
    },
    "providerPolicy": {
      "enum": ["fixed", "configurable", "unknown"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/capabilityState"}
    },
    "supportedPlatforms": {
      "type": "array",
      "items": {"$ref": "#/$defs/nonempty"},
      "uniqueItems": true
    },
    "supportedHarnessVersions": {"$ref": "#/$defs/nonempty"},
    "entrypoint": {"$ref": "#/$defs/nonempty"},
    "permissions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "capabilityState": {
      "enum": ["supported", "unsupported", "unverified", "degraded"]
    }
  }
}
