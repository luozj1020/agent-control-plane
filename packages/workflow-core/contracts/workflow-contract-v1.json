{
  "contract_id": "ai-coding-workflow",
  "contract_version": "1.6.0",
  "invariants": [
    "explicit-mode-selection",
    "single-writer",
    "hash-bound-evidence",
    "tools-establish-facts-models-make-claims",
    "models-never-merge",
    "human-retains-sensitive-authority"
  ],
  "modes": [
    {
      "entrypoint": [
        "python",
        "ai/aiwf.py",
        "submit",
        "TASK.json"
      ],
      "id": "overnight",
      "ownership": "downstream-convergence",
      "upstream_lifecycle": "bookends"
    },
    {
      "entrypoint": [
        "python",
        "ai/aiwf.py",
        "balanced",
        "TASK.json"
      ],
      "id": "balanced",
      "ownership": "round-based",
      "upstream_lifecycle": "active-between-rounds"
    },
    {
      "entrypoint": null,
      "id": "interactive",
      "ownership": "upstream-continuous",
      "upstream_lifecycle": "continuous"
    }
  ],
  "overnight_strategies": [
    {
      "id": "convergent",
      "scope_rule": "non-expanding",
      "stop_rule": "acceptance-approved"
    },
    {
      "id": "continuous-improvement",
      "scope_rule": "acceptance-floor-preserving",
      "stop_rule": "operator-interrupt"
    }
  ],
  "producer": {
    "cli": "aiwf",
    "repository": "ai-coding-workflow"
  },
  "projections": {
    "control_plane_runtime": {
      "balanced": {
        "active_state": "running",
        "decision_states": {
          "accept": "accepted",
          "revise": "revision_pending",
          "stop": "stopped"
        },
        "evidence_statuses": [
          "review_pending",
          "runtime_blocked",
          "budget_exhausted",
          "scope_violation",
          "validation_failed"
        ],
        "initial_state": "created",
        "outcome_states": {
          "budget_failure": "budget_exhausted",
          "ready": "review_pending",
          "runtime_failure": "runtime_blocked",
          "scope_failure": "scope_violation",
          "validation_failure": "validation_failed"
        },
        "review_decisions": [
          "accept",
          "revise",
          "stop"
        ],
        "review_state": "review_pending",
        "states": [
          "created",
          "running",
          "review_pending",
          "revision_pending",
          "accepted",
          "stopped"
        ],
        "terminal_states": [
          "accepted",
          "stopped"
        ]
      },
      "overnight": {
        "active_state": "running",
        "decision_states": {
          "accept": "accepted",
          "continue": "submitted",
          "interrupt": "interrupted",
          "interrupt_requested": "interrupt_requested",
          "revise": "submitted",
          "stop": "stopped"
        },
        "initial_state": "submitted",
        "outcome_states": {
          "convergent_ready": "revision_pending",
          "improvement_ready": "improvement_cycle_ready",
          "interrupted": "interrupted",
          "no_change": "revision_pending",
          "runtime_failure": "runtime_blocked",
          "scope_failure": "scope_violation",
          "validation_failure": "validation_failed"
        },
        "review_decisions": {
          "improvement_cycle_ready": [
            "continue",
            "revise",
            "stop"
          ],
          "revision_pending": [
            "accept",
            "revise",
            "stop"
          ],
          "runtime_blocked": [
            "stop"
          ],
          "scope_violation": [
            "stop"
          ],
          "validation_failed": [
            "stop"
          ]
        },
        "states": [
          "submitted",
          "running",
          "revision_pending",
          "improvement_cycle_ready",
          "runtime_blocked",
          "scope_violation",
          "validation_failed",
          "accepted",
          "stopped",
          "interrupted",
          "interrupt_requested"
        ],
        "terminal_states": [
          "accepted",
          "stopped",
          "interrupted"
        ],
        "wake_states": [
          "revision_pending",
          "improvement_cycle_ready",
          "runtime_blocked",
          "scope_violation",
          "validation_failed"
        ]
      }
    },
    "coordination_observability": {
      "content_policy": "metadata-only",
      "coverage_policy": "unsupported-is-not-zero",
      "derived_metric_policy": "recorded-events-only",
      "detail_projection_policy": "allowlist-metadata-only",
      "detail_schema_binding": "coordination-run-detail-v1",
      "event_kinds": [
        "run_created",
        "agent_invoke_started",
        "agent_invoke_completed",
        "artifact_read",
        "artifact_write",
        "state_transition",
        "review_decision",
        "validation_completed",
        "wake_requested",
        "wake_delivered",
        "interrupt_requested"
      ],
      "event_schema_binding": "coordination-event-v1",
      "measurement_sources": [
        "runtime",
        "filesystem_snapshot",
        "provider_reported",
        "derived",
        "agent_claimed"
      ],
      "read_audit_policy": "explicit-events-only",
      "read_containment_modes": [
        "exact-paths",
        "partial-event-audit",
        "unsupported"
      ],
      "summary_schema_binding": "coordination-run-summary-v1",
      "temporal_order_policy": "append-sequence",
      "topology_metrics": [
        "node-count",
        "relationship-count",
        "unique-read-artifacts",
        "repeated-artifact-reads",
        "artifact-reader-links",
        "max-artifact-reader-fan-out"
      ],
      "write_containment_modes": [
        "exact-paths",
        "post-run-audit",
        "unsupported"
      ]
    },
    "task_card": {
      "interface_ownership": {
        "interface_path": "extensions.task_shape.interfaces",
        "participant_path": "extensions.task_shape.participants",
        "reference_policy": "declared-participants-only",
        "validation_policy": "reference-or-preflight-warning"
      },
      "schema_binding": "task-card-v1",
      "schema_version": 1
    }
  },
  "review": {
    "balanced_decisions": [
      "accept",
      "revise",
      "stop"
    ],
    "overnight_decisions": [
      "accept",
      "revise"
    ],
    "revision_delta": "bounded-non-expanding"
  },
  "runtime": {
    "balanced": {
      "states": [
        "review_pending"
      ],
      "success_states": [],
      "terminal_states": [],
      "wake_states": [
        "review_pending"
      ]
    },
    "bookend": {
      "states": [
        "submitted",
        "converging",
        "classifying",
        "recovering",
        "projecting",
        "checkpoint_ready",
        "revision_pending",
        "review_ready",
        "semantic_blocked",
        "runtime_blocked",
        "authority_blocked",
        "budget_exhausted",
        "cancelled"
      ],
      "success_states": [
        "review_ready"
      ],
      "terminal_states": [
        "review_ready",
        "semantic_blocked",
        "runtime_blocked",
        "authority_blocked",
        "budget_exhausted",
        "cancelled"
      ],
      "wake_states": [
        "checkpoint_ready",
        "revision_pending",
        "semantic_blocked"
      ]
    }
  },
